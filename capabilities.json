      "enabled": true,
      "description": "User interaction handling for depth >= 3 requirement",
      "maxDepth": 3,
      "strategies": {
        "auto": {
          "enabled": true,
          "description": "Automatically detect and apply best strategy",
          "priority": ["pagination", "load_more", "scroll", "tabs"]
        },
        "tabs": {
          "enabled": true,
          "description": "Click tab elements to reveal hidden content",
          "maxClicks": 5,
          "selectors": [
            "[role=\"tab\"]",
            ".tab",
            "button.tab",
            ".nav-tab",
            "[data-tab]"
          ]
        },
        "load_more": {
          "enabled": true,
          "description": "Click 'Load More' or 'Show More' buttons repeatedly",
          "maxClicks": 3,
          "waitBetweenClicks": 2,
          "detectContentChange": true
        },
        "scroll": {
          "enabled": true,
          "description": "Infinite scroll handling with content change detection",
          "maxScrolls": 3,
          "waitBetweenScrolls": 2,
          "scrollAmount": "viewport"
        },
        "pagination": {
          "enabled": true,
          "description": "Navigate through Next/Previous links",
          "maxPages": 3,
          "selectors": [
            "a:has-text(\"Next\")",
            "button:has-text(\"Next\")",
            "[rel=\"next\"]",
            ".next"
          ]
        },
        "all": {
          "enabled": true,
          "description": "Attempt all strategies in sequence",
          "note": "May be slow - use sparingly"
        }
      }
    },
